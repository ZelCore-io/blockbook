{
  "coin": {
    "name": "Zclassic",
    "shortcut": "ZCL",
    "label": "Zclassic",
    "alias": "zclassic"
  },
  "ports": {
    "backend_rpc": 8063,
    "backend_message_queue": 38363,
    "blockbook_internal": 9063,
    "blockbook_public": 9163,
    "blockbook_insight": 3001
  },
  "ipc": {
    "rpc_url_template": "http://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_url_ws_template": "ws://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_user": "rpc",
    "rpc_pass": "rpc",
    "rpc_timeout": 25,
    "message_queue_binding_template": "tcp://127.0.0.1:{{.Ports.BackendMessageQueue}}"
  },
  "backend": {
    "package_name": "backend-zclassic",
    "package_revision": "satoshilabs-1",
    "system_user": "zclassic",
    "version": "2.1.1.60",
    "binary_url": "https://github.com/ZclassicCommunity/zclassic/releases/download/v2.1.1.60/zclassic-linux-ubuntu-22.04-x86_64-2-1-1-60.tar.gz",
    "verification_type": "sha256",
    "verification_source": "02ddf2e908ac6008a4a1d612579723f2ad16c1c793671ece4b6249ced49de665",
    "extract_command": "tar -C backend --strip 1 -xf",
    "exclude_files": [
      "zclassic-tx"
    ],
    "exec_command_template": "{{.Env.BackendInstallPath}}/{{.Coin.Alias}}/zclassicd -datadir={{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend -conf={{.Env.BackendInstallPath}}/{{.Coin.Alias}}/{{.Coin.Alias}}.conf -pid=/run/{{.Coin.Alias}}/{{.Coin.Alias}}.pid",
    "logrotate_files_template": "{{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend/*.log",
    "postinst_script_template": "",
    "service_type": "forking",
    "service_additional_params_template": "Environment=\"HOME={{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend\"",
    "protect_memory": false,
    "mainnet": true,
    "server_config_file": "bitcoin_like.conf",
    "client_config_file": "bitcoin_like_client.conf",
    "additional_params": {
      "addnode": [
        "explorer.zcl.zelcore.io"
      ],
      "mempoolexpiry": 24
    }
  },
  "blockbook": {
    "package_name": "blockbook-zclassic",
    "system_user": "blockbook-zclassic",
    "internal_binding_template": ":{{.Ports.BlockbookInternal}}",
    "public_binding_template": ":{{.Ports.BlockbookPublic}}",
    "insight_binding_template": "${BLOCKBOOK_INSIGHT_HOST}:{{.Ports.BlockbookInsight}}",
    "insight_ui": true,
    "explorer_url": "",
    "additional_params": "-resyncindexperiod=60017 -resyncmempoolperiod=10000",
    "block_chain": {
      "parse": true,
      "mempool_workers": 4,
      "mempool_sub_workers": 8,
      "block_addresses_to_keep": 300,
      "xpub_magic": 76067358,
      "slip44": 147,
      "additional_params": {
        "averageBlockTimeMs": 75000,
        "insight_supply_utxo_scan": true,
        "public_url": "https://explorer.zcl.zelcore.io",
        "fiat_rates": "coingecko",
        "fiat_rates_vs_currencies": "AED,ARS,AUD,BDT,BHD,BMD,BRL,CAD,CHF,CLP,CNY,CZK,DKK,EUR,GBP,HKD,HUF,IDR,ILS,INR,JPY,KRW,KWD,LKR,MMK,MXN,MYR,NGN,NOK,NZD,PHP,PKR,PLN,RUB,SAR,SEK,SGD,THB,TRY,TWD,UAH,USD,VND,ZAR,BTC,ETH",
        "fiat_rates_params": "{\"url\": \"https://viprates.zelcore.io/v2/blockbook/api/v3\", \"tipUrl\": \"https://viprates.zelcore.io/v2/blockbook/api/v3\", \"attribution\": \"ZelCore\", \"coin\": \"zclassic\", \"periodSeconds\": 900}"
      }
    }
  },
  "meta": {
    "package_maintainer": "Vasilis",
    "package_maintainer_email": "vasilis@runonflux.io"
  }
}
