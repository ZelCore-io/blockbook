{
  "coin": {
    "name": "Anon",
    "shortcut": "ANON",
    "label": "Anon",
    "alias": "anon"
  },
  "ports": {
    "backend_rpc": 8076,
    "backend_message_queue": 38376,
    "blockbook_internal": 9076,
    "blockbook_public": 9176,
    "blockbook_insight": 3001
  },
  "ipc": {
    "rpc_url_template": "http://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_url_ws_template": "ws://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_user": "rpc",
    "rpc_pass": "rpc",
    "rpc_timeout": 60,
    "message_queue_binding_template": "tcp://127.0.0.1:{{.Ports.BackendMessageQueue}}"
  },
  "backend": {
    "package_name": "backend-anon",
    "package_revision": "satoshilabs-1",
    "system_user": "anon",
    "version": "2.2.0-62",
    "binary_url": "https://github.com/anonymousbitcoin/anon/releases/download/v.2.2.0-62/ubuntu-20.04.tar.gz",
    "verification_type": "sha256",
    "verification_source": "8bb44d7088255d5d2eed60df9e6452bbb72d5d3c670ba41d31b51786ea29fe2a",
    "extract_command": "tar -C backend --strip 1 -xf",
    "exclude_files": [],
    "exec_command_template": "{{.Env.BackendInstallPath}}/{{.Coin.Alias}}/anond -datadir={{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend -conf={{.Env.BackendInstallPath}}/{{.Coin.Alias}}/{{.Coin.Alias}}.conf -pid=/run/{{.Coin.Alias}}/{{.Coin.Alias}}.pid",
    "logrotate_files_template": "{{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend/*.log",
    "postinst_script_template": "",
    "service_type": "forking",
    "service_additional_params_template": "Environment=\"HOME={{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend\"",
    "protect_memory": false,
    "mainnet": true,
    "server_config_file": "bitcoin_like.conf",
    "client_config_file": "bitcoin_like_client.conf",
    "additional_params": {
      "addnode": [
        "142.4.192.218",
        "169.197.131.10",
        "47.241.65.100",
        "47.242.230.93",
        "47.242.254.18",
        "95.214.53.136",
        "95.214.55.8"
      ],
      "mempoolexpiry": 24
    }
  },
  "blockbook": {
    "package_name": "blockbook-anon",
    "system_user": "blockbook-anon",
    "internal_binding_template": ":{{.Ports.BlockbookInternal}}",
    "public_binding_template": ":{{.Ports.BlockbookPublic}}",
    "insight_binding_template": "${BLOCKBOOK_INSIGHT_HOST}:{{.Ports.BlockbookInsight}}",
    "insight_ui": true,
    "explorer_url": "",
    "additional_params": "-resyncindexperiod=60017 -resyncmempoolperiod=10000",
    "block_chain": {
      "parse": true,
      "mempool_workers": 4,
      "mempool_sub_workers": 8,
      "block_addresses_to_keep": 300,
      "xpub_magic": 76067358,
      "slip44": 220,
      "additional_params": {
        "averageBlockTimeMs": 150000,
        "public_url": "https://explorer.anon.zelcore.io"
      }
    }
  },
  "meta": {
    "package_maintainer": "Vasilis",
    "package_maintainer_email": "vasilis@runonflux.io"
  }
}
