{
  "coin": {
    "name": "Axe",
    "shortcut": "AXE",
    "label": "Axe",
    "alias": "axe"
  },
  "ports": {
    "backend_rpc": 8069,
    "backend_message_queue": 38369,
    "blockbook_internal": 9069,
    "blockbook_public": 9169,
    "blockbook_insight": 3001
  },
  "ipc": {
    "rpc_url_template": "http://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_url_ws_template": "ws://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_user": "rpc",
    "rpc_pass": "rpc",
    "rpc_timeout": 25,
    "message_queue_binding_template": "tcp://127.0.0.1:{{.Ports.BackendMessageQueue}}"
  },
  "backend": {
    "package_name": "backend-axe",
    "package_revision": "satoshilabs-1",
    "system_user": "axe",
    "version": "1.6.1.1",
    "binary_url": "https://github.com/AXErunners/axe/releases/download/v1.6.1.1/axecore-1.6.1.1-x86_64-linux-gnu.tar.gz",
    "verification_type": "sha256",
    "verification_source": "f6f8daffa90bfeeb095938144b4a75bd4887fff0d93545d427ca3b1f5cc7e16d",
    "extract_command": "tar -C backend --strip 1 -xf",
    "exclude_files": [
      "bin/axe-qt"
    ],
    "exec_command_template": "{{.Env.BackendInstallPath}}/{{.Coin.Alias}}/bin/axed -deprecatedrpc=estimatefee -datadir={{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend -conf={{.Env.BackendInstallPath}}/{{.Coin.Alias}}/{{.Coin.Alias}}.conf -pid=/run/{{.Coin.Alias}}/{{.Coin.Alias}}.pid",
    "logrotate_files_template": "{{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend/*.log",
    "postinst_script_template": "",
    "service_type": "forking",
    "service_additional_params_template": "",
    "protect_memory": true,
    "mainnet": true,
    "server_config_file": "bitcoin_like.conf",
    "client_config_file": "bitcoin_like_client.conf",
    "additional_params": {
      "mempoolexpiry": 72
    }
  },
  "blockbook": {
    "package_name": "blockbook-axe",
    "system_user": "blockbook-axe",
    "internal_binding_template": ":{{.Ports.BlockbookInternal}}",
    "public_binding_template": ":{{.Ports.BlockbookPublic}}",
    "insight_binding_template": "${BLOCKBOOK_INSIGHT_HOST}:{{.Ports.BlockbookInsight}}",
    "insight_ui": true,
    "explorer_url": "",
    "additional_params": "-resyncindexperiod=60017 -resyncmempoolperiod=10000",
    "block_chain": {
      "parse": true,
      "mempool_workers": 8,
      "mempool_sub_workers": 2,
      "block_addresses_to_keep": 300,
      "xpub_magic": 76067358,
      "slip44": 4242,
      "additional_params": {
        "averageBlockTimeMs": 150000,
        "public_url": "https://explorer.axe.zelcore.io"
      }
    }
  },
  "meta": {
    "package_maintainer": "Vasilis",
    "package_maintainer_email": "vasilis@runonflux.io"
  }
}
