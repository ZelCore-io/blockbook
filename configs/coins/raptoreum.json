{
  "coin": {
    "name": "Raptoreum",
    "shortcut": "RTM",
    "label": "Raptoreum",
    "alias": "raptoreum"
  },
  "ports": {
    "backend_rpc": 8077,
    "backend_message_queue": 38377,
    "blockbook_internal": 9077,
    "blockbook_public": 9177,
    "blockbook_electrum_http": 3456
  },
  "ipc": {
    "rpc_url_template": "http://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_url_ws_template": "ws://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_user": "rpc",
    "rpc_pass": "rpc",
    "rpc_timeout": 25,
    "message_queue_binding_template": "tcp://127.0.0.1:{{.Ports.BackendMessageQueue}}"
  },
  "backend": {
    "package_name": "backend-raptoreum",
    "package_revision": "satoshilabs-1",
    "system_user": "raptoreum",
    "version": "2.0.3.01",
    "binary_url": "https://github.com/Raptor3um/raptoreum/releases/download/2.0.3.01-mainnet/raptoreum-ubuntu22-2.0.3.01-mainnet-.tar.gz",
    "verification_type": "sha256",
    "verification_source": "1dfb7b127485b668eb9cbeecd585028075580aaa302d96dad89f9790741aeb60",
    "extract_command": "tar -C backend -xf",
    "exclude_files": [
      "raptoreum-qt",
      "checksums.txt"
    ],
    "exec_command_template": "{{.Env.BackendInstallPath}}/{{.Coin.Alias}}/raptoreumd -datadir={{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend -conf={{.Env.BackendInstallPath}}/{{.Coin.Alias}}/{{.Coin.Alias}}.conf -pid=/run/{{.Coin.Alias}}/{{.Coin.Alias}}.pid",
    "logrotate_files_template": "{{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend/*.log",
    "postinst_script_template": "",
    "service_type": "forking",
    "service_additional_params_template": "",
    "protect_memory": true,
    "mainnet": true,
    "server_config_file": "bitcoin_like.conf",
    "client_config_file": "bitcoin_like_client.conf",
    "additional_params": {
      "mempoolexpiry": 72
    }
  },
  "blockbook": {
    "package_name": "blockbook-raptoreum",
    "system_user": "blockbook-raptoreum",
    "internal_binding_template": ":{{.Ports.BlockbookInternal}}",
    "public_binding_template": ":{{.Ports.BlockbookPublic}}",
    "explorer_url": "",
    "additional_params": "-workers=1",
    "electrum_http_binding_template": "${BLOCKBOOK_INSIGHT_HOST}:{{.Ports.BlockbookElectrumHTTP}}",
    "block_chain": {
      "parse": false,
      "subversion": "/Raptoreum Core:2.0.3.1/",
      "mempool_workers": 2,
      "mempool_sub_workers": 1,
      "block_addresses_to_keep": 300,
      "xpub_magic": 76067358,
      "slip44": 10226,
      "additional_params": {
        "averageBlockTimeMs": 120000,
        "fiat_rates": "coingecko",
        "fiat_rates_vs_currencies": "AED,ARS,AUD,BDT,BHD,BMD,BRL,CAD,CHF,CLP,CNY,CZK,DKK,EUR,GBP,HKD,HUF,IDR,ILS,INR,JPY,KRW,KWD,LKR,MMK,MXN,MYR,NGN,NOK,NZD,PHP,PKR,PLN,RUB,SAR,SEK,SGD,THB,TRY,TWD,UAH,USD,VND,ZAR,BTC,ETH",
        "fiat_rates_params": "{\"url\": \"https://viprates.zelcore.io/v2/blockbook/api/v3\", \"tipUrl\": \"https://viprates.zelcore.io/v2/blockbook/api/v3\", \"attribution\": \"ZelCore\", \"coin\": \"raptoreum\", \"periodSeconds\": 900}"
      }
    }
  },
  "meta": {
    "package_maintainer": "Vasilis",
    "package_maintainer_email": "vasilis@runonflux.io"
  }
}
